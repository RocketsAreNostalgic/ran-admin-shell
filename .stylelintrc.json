{
	"extends": [
		"@rocketsarenostalgic/quality-config/stylelint/wordpress"
	],
	"rules": {
		"selector-class-pattern": "^([a-z][a-z0-9]*)(-[a-z0-9]+)*(?:__[a-z0-9]+(?:-[a-z0-9]+)*)?(?:--[a-z0-9]+(?:-[a-z0-9]+)*)?$",
		"rule-empty-line-before": [
			"always",
			{
				"ignore": [
					"after-comment",
					"first-nested"
				]
			}
		]
	}
}
