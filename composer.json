{
	"name": "ran/admin-shell",
	"description": "Build-time admin-shell resources for Rockets Are Nostalgic WordPress plugins.",
	"type": "library",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.0",
		"composer-runtime-api": "^2.2",
		"ext-hash": "*",
		"ext-json": "*"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.1",
		"phpcompatibility/php-compatibility": "10.0.0-alpha2",
		"phpcompatibility/phpcompatibility-paragonie": "2.0.0-alpha2",
		"phpcompatibility/phpcompatibility-wp": "3.0.0-alpha2",
		"phpunit/phpunit": "^9.6",
		"ran/coding-standards": "^1.0"
	},
	"bin": [
		"bin/ran-admin-shell"
	],
	"scripts": {
		"lint:syntax": "@php tools/lint-syntax.php",
		"standards": [
			"phpcs -p",
			"phpcs --standard=phpcs-tooling.xml.dist -p"
		],
		"standards:fix": "@php tools/fix-standards.php",
		"test": "phpunit --configuration phpunit.xml.dist",
		"check": [
			"@lint:syntax",
			"@standards",
			"@test"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.0.30"
		},
		"sort-packages": true
	},
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/RocketsAreNostalgic/ran-coding-standards"
		}
	]
}
